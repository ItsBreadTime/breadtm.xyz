{
	"name": "breadtm.xyz",
	"version": "0.0.1",
	"private": true,
	"browserslist": [
		"defaults",
		"not IE 11"
	],
	"packageManager": "pnpm@10.12.1",
	"scripts": {
		"dev": "pnpm run precompile && vite dev --host",
		"build": "pnpm run precompile && vite build",
		"preview": "vite preview",
		"test": "node --test 'src/lib/**/*.test.ts' 'scripts/**/*.test.mjs'",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"compress-images": "node scripts/compress-images.js",
		"compress-images:prune": "node scripts/compress-images.js --prune",
		"precompile": "node scripts/precompile-toys.js"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/typography": "^0.5.20",
		"@types/node": "^24.19.0",
		"@types/sanitize-html": "^2.16.2",
		"autoprefixer": "^10.6.1",
		"mdsvex": "^0.12.8",
		"postcss": "^8.5.28",
		"sharp": "^0.35.5",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^3.4.19",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"wrangler": "^4.145.0"
	},
	"type": "module",
	"dependencies": {
		"sanitize-html": "^2.18.0"
	},
	"pnpm": {
		"overrides": {
			"cookie": "^0.7.0"
		}
	}
}
